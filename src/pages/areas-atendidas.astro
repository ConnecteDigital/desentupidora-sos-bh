---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import { site } from '../data/site';
import CityCard from '../components/CityCard.astro';
import { cidades, nomesCidades } from '../data/cidades';
import { breadcrumbSchema } from '../data/schema';

const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Áreas atendidas', path: '/areas-atendidas/' },
];
---

<Base
  title="Áreas Atendidas: Desentupidora 24h em BH e Região | SOS BH"
  description={`Desentupidora 24 horas em ${nomesCidades}. Chegamos em até ${site.arrivalMinutes} minutos, com garantia.`}
  schema={[breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">Áreas atendidas</span>
      <h1>Desentupidora em BH e região</h1>
      <p class="hero-lead">Atendemos 24 horas em {nomesCidades}. Escolha a sua cidade.</p>
      <CtaButtons />
    </div>
  </section>
  <section class="section section-soft">
    <div class="container zones">
      {cidades.map((c) => <CityCard cidade={c} heading="h2" />)}
    </div>
  </section>
  <CtaBand />
</Base>
