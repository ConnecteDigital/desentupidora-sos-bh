---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import CtaButtons from '../components/CtaButtons.astro';
import CtaBand from '../components/CtaBand.astro';
import FaqList from '../components/FaqList.astro';
import ServiceCard from '../components/ServiceCard.astro';
import { site } from '../data/site';
import { servicos } from '../data/servicos';
import { cidades, cidadePath, type Cidade } from '../data/cidades';
import { breadcrumbSchema, faqSchema, serviceSchema } from '../data/schema';

export function getStaticPaths() {
  return cidades.map((cidade) => ({ params: { slug: cidade.slug }, props: { cidade } }));
}

interface Props {
  cidade: Cidade;
}

const { cidade } = Astro.props;
const path = cidadePath(cidade);
const crumbs = [
  { name: 'Início', path: '/' },
  { name: 'Áreas atendidas', path: '/areas-atendidas/' },
  { name: `Desentupidora em ${cidade.nome}`, path },
];
const faq = [
  {
    q: `Vocês atendem em ${cidade.nome} 24 horas?`,
    a: `Sim. Atendemos ${cidade.nome} 24 horas por dia, inclusive fins de semana e feriados.`,
  },
  {
    q: `Em quanto tempo a desentupidora chega em ${cidade.nome}?`,
    a: `Chegamos em até ${site.arrivalMinutes} minutos em ${cidade.nome}.`,
  },
  {
    q: `Atendem bairros como ${cidade.bairros.slice(0, 2).join(' e ')}?`,
    a: `Sim. Atendemos ${cidade.bairros.join(', ')} e os demais bairros de ${cidade.nome}.`,
  },
  {
    q: 'O serviço tem garantia?',
    a: `Sim. Todos os serviços da ${site.name} têm garantia.`,
  },
];
const outrasCidades = cidades.filter((c) => c.slug !== cidade.slug);
const msg = `Olá! Vim pelo site da ${site.name} e preciso de um desentupimento em ${cidade.nome}.`;
const servicoSchema = { ...serviceSchema(servicos[0], cidade.nome), name: `Desentupidora em ${cidade.nome}`, serviceType: 'Desentupimento' };
---

<Base
  title={`Desentupidora em ${cidade.nome} 24h | Chegamos em ${site.arrivalMinutes} min | SOS BH`}
  description={`Desentupidora em ${cidade.nome}, MG. Desentupimento de esgoto, pia, vaso sanitário, ralo e caixa de gordura 24 horas. Chegamos em até ${site.arrivalMinutes} minutos, com garantia.`}
  schema={[servicoSchema, faqSchema(faq), breadcrumbSchema(crumbs)]}
>
  <section class="hero page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <span class="eyebrow">{cidade.nome} · MG · Plantão 24h</span>
      <h1>Desentupidora em {cidade.nome} 24 horas</h1>
      <p class="hero-lead">
        Precisa de desentupidora em {cidade.nome}? A {site.name} atende 24 horas e chega em até {site.arrivalMinutes} minutos
        para desentupir esgoto, pia, vaso sanitário, ralo e caixa de gordura, com garantia.
      </p>
      <CtaButtons message={msg} />
    </div>
  </section>

  <section class="section">
    <div class="container content-grid">
      <article class="prose">
        <h2>Desentupidora 24h em {cidade.nome}</h2>
        {cidade.sobre.map((p) => <p>{p}</p>)}

        <h2>O que fazemos em {cidade.nome}</h2>
        <ul>
          {servicos.map((s) => <li><a href={`/servicos/${s.slug}/`}>{s.nome}</a></li>)}
        </ul>

        <h2>Bairros atendidos em {cidade.nome}</h2>
        <p>Atendemos todos os bairros de {cidade.nome}, entre eles:</p>
        <ul class="tags-list">
          {cidade.bairros.map((b) => <li>{b}</li>)}
        </ul>

        <h2>Perguntas frequentes</h2>
        <FaqList items={faq} />
      </article>

      <aside class="sidebar">
        <div class="side-card">
          <h2>Desentupidora em {cidade.nome} agora</h2>
          <p>Fale com a gente e receba atendimento em até {site.arrivalMinutes} minutos.</p>
          <CtaButtons message={msg} size="md" />
        </div>
        <div class="side-list">
          <h2>Outras cidades</h2>
          <ul>
            {outrasCidades.map((c) => <li><a href={cidadePath(c)}>Desentupidora em {c.nome}</a></li>)}
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Serviços em {cidade.nome}</span>
        <h2>Serviços de desentupimento em {cidade.nome}</h2>
      </div>
      <div class="services-grid">
        {servicos.map((s) => <ServiceCard servico={s} />)}
      </div>
    </div>
  </section>

  <CtaBand title={`Desentupidora em ${cidade.nome} agora`} message={msg} />
</Base>
